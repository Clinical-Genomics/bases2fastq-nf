// For Nextflow version below 24.04.0
// Hasta general parameters
params {
    config_profile_description = 'Hasta, a local cluster setup at Clinical Genomics, Stockholm.'
    config_profile_contact = 'Clinical Genomics, Stockholm'
    config_profile_url = 'https://github.com/Clinical-Genomics'

    max_memory = 180.GB
    max_cpus   = 36
    max_time   = 336.h

    account = "development"
    qos     = "normal"

}

// Slurm as executor and slurm options
executor {
    name = 'slurm'
    pollInterval = '2 min'
    queueStatInterval = '5 min'
    submitRateLimit = '2 sec'
}

case_workdir = System.getenv('NXF_WORK')

// Set environmental variables
env {
    TMPDIR="${case_workdir}"
    JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=${case_workdir}"
    MPLCONFIGDIR="${case_workdir}"
    XDG_CACHE_HOME="${case_workdir}"
}

// Set singularity settings
singularity {
    enabled = true
    envWhitelist = ['JAVA_TOOL_OPTIONS']
    autoMounts = true
    runOptions = "--bind ${case_workdir}"
}

process {

    withName: 'BASES2FASTQ' {
        cluster.Options = "-A ${params.account} -p ${params.qos}"
        cpus = {
            def cpu_list = [36, 28, 20] // Define CPU scaling sequence
            return task.attempt <= cpu_list.size() ? cpu_list[task.attempt - 1] : 12 // Use last value if attempts exceed list
        }
        memory = { check_max(180.GB, 'memory') } // Keep memory constant
        time   = { check_max( 3.h * task.attempt, 'time'    ) }
        maxRetries = 4
    }
}
